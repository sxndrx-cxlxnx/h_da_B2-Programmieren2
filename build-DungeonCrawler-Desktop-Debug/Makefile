		../DungeonCrawler/tile.h \
		../DungeonCrawler/character.h \
		../DungeonCrawler/wall.h \
		../DungeonCrawler/floor.h \
		../DungeonCrawler/portal.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o level.o ../DungeonCrawler/level.cpp

